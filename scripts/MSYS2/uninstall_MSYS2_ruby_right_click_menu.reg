Windows Registry Editor Version 5.00
; DESCRIPTION
; Uninstalls right-click menu options for the Ruby 2.7 bundled MSYS2 terminal.

; USAGE
; Right-click this file and click "Merge," or double-click it, then click "Yes" and "Ok."


; CODE
; THIS SECTION removes right-click on folder background options for Ruby 2.7.
[-HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\mingw32]
[-HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\mingw64]
[-HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\msys2]

; THIS SECTION removes right-click on folder options for Ruby 2.7.
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\mingw32]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\mingw64]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\msys2]